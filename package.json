{
  "name": "@thiagosbrito/code-factory",
  "version": "0.3.0-beta.0",
  "description": "A local, agent-independent coding loop factory",
  "keywords": [
    "agents",
    "ai",
    "claude-code",
    "cli",
    "codex",
    "coding-agent",
    "kiro",
    "workflow"
  ],
  "homepage": "https://github.com/thiagosbrito/code-factory#readme",
  "bugs": {
    "url": "https://github.com/thiagosbrito/code-factory/issues"
  },
  "license": "MIT",
  "author": "Thiago Brito",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thiagosbrito/code-factory.git"
  },
  "bin": {
    "code-factory": "dist/node/cli.js"
  },
  "files": [
    "dist",
    "docs/architecture.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx watch scripts/dev.mts",
    "dev:ui": "vite",
    "dev:runtime": "tsx watch src/cli.ts start --port 4310 --no-open",
    "build": "node scripts/clean.mjs && tsc -p tsconfig.runtime.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint --threads=2",
    "format": "oxfmt --threads=2",
    "format:check": "oxfmt --check --threads=2",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:native": "CODE_FACTORY_E2E_NATIVE=1 playwright test native-onboarding.spec.ts",
    "test:package": "node scripts/smoke-package.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "prepack": "pnpm build",
    "prove:codex": "pnpm build && node scripts/prove-codex.mjs",
    "prove:claude": "tsx scripts/prove-claude.mts",
    "prepublishOnly": "pnpm check && pnpm test:package"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "1.4.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "@xyflow/react": "12.12.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "jsdom": "^30.1.1",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.8.0"
}
